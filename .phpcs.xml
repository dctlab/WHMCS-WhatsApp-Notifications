<?xml version="1.0"?>

<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="DCTLAB WHMCS WhatsApp Notifications"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

    <description>
        DCTLAB coding standards for the WHMCS WhatsApp Notifications module.
    </description>

    <!-- ==============================================================
         FILES
         ============================================================== -->

    <!-- WHMCS addon entry point -->
    <file>./dct_whatsapp_notifications.php</file>

    <!-- Application source -->
    <file>./src</file>

    <!-- Do not inspect third-party/generated code -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Composer/cache/generated files -->
    <exclude-pattern>*/composer-cache/*</exclude-pattern>
    <exclude-pattern>*/composer-data/*</exclude-pattern>
    <exclude-pattern>*/composer-archive/*</exclude-pattern>

    <!-- Development stubs -->
    <exclude-pattern>*/stubs.php</exclude-pattern>
    <exclude-pattern>*/stubs_generator.php</exclude-pattern>
    <exclude-pattern>*/docs/whmcs-common-stubs.php</exclude-pattern>

    <!-- Minified JavaScript -->
    <exclude-pattern>*.min.js</exclude-pattern>

    <!-- ==============================================================
         COMMAND LINE
         ============================================================== -->

    <!-- Display paths relative to project root -->
    <arg name="basepath" value="."/>

    <!-- Check multiple files in parallel -->
    <arg name="parallel" value="2"/>

    <!-- Show progress -->
    <arg name="colors"/>

    <!-- PHP compatibility target: minimum supported PHP version -->
    <config name="php_version" value="8.1"/>

    <!-- ==============================================================
         CORE CODING STANDARD
         ============================================================== -->

    <!-- PSR-12 provides the baseline PHP coding standard -->
    <rule ref="PSR12"/>

    <!-- ==============================================================
         FILE FORMAT
         ============================================================== -->

    <!-- Unix LF line endings -->
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>

    <!-- Every PHP file must end with exactly one newline -->
    <rule ref="PSR12.Files.FileHeader">
        <severity>0</severity>
    </rule>

    <!-- No closing ?> in PHP-only files -->
    <rule ref="PSR2.Files.ClosingTag"/>

    <!-- ==============================================================
         LINE LENGTH
         ============================================================== -->

    <!-- Preferred maximum: 120 characters -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- ==============================================================
         WHITESPACE
         ============================================================== -->

    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>

    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>

    <!-- ==============================================================
         PHP LANGUAGE
         ============================================================== -->

    <rule ref="Generic.PHP.LowerCaseKeyword"/>
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.PHP.LowerCaseType"/>

    <!-- ==============================================================
         FUNCTIONS / METHODS
         ============================================================== -->

    <!-- Require visibility declarations -->
    <rule ref="Squiz.Scope.MethodScope"/>

    <!-- Method/function declaration formatting -->
    <rule ref="PSR2.Methods.MethodDeclaration"/>

    <!-- Function call formatting -->
    <rule ref="PSR2.Methods.FunctionCallSignature"/>

    <!-- Lowercase function keywords -->
    <rule ref="Squiz.Functions.LowercaseFunctionKeywords"/>

    <!-- ==============================================================
         NAMING
         ============================================================== -->

    <rule ref="Squiz.NamingConventions.ValidVariableName"/>

    <!-- ==============================================================
         COMMENTS / DOCUMENTATION
         ============================================================== -->

    <!-- Function documentation is recommended rather than mandatory -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <type>warning</type>
    </rule>

    <rule ref="Squiz.Commenting.FunctionCommentThrowTag">
        <type>warning</type>
    </rule>

    <rule ref="Squiz.Commenting.DocCommentAlignment"/>

    <!-- ==============================================================
         CODE QUALITY
         ============================================================== -->

    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>

    <!-- ==============================================================
         ARRAYS
         ============================================================== -->

    <rule ref="Generic.Arrays.ArrayIndent"/>

    <!-- ==============================================================
         OPTIONAL SLEVOMAT RULES
         ==============================================================
         These rules require:
         slevomat/coding-standard
         ============================================================== -->

    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>

    <rule ref="SlevomatCodingStandard.Namespaces.NamespaceSpacing"/>

    <rule ref="SlevomatCodingStandard.Namespaces.UseSpacing"/>

    <rule ref="SlevomatCodingStandard.Classes.MethodSpacing"/>

    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>

    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInCall"/>

    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInClosureUse"/>

    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInDeclaration"/>

    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>

</ruleset>
